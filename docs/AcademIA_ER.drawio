        <mxCell id="c134" value="&lt;b&gt;MAESTRA&lt;/b&gt; (3)&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Datos base que existen por sí solos y que otras tablas reutilizan.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;ESTUDIANTE, DOCENTE, MATERIA&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#1B2145;" vertex="1" parent="1"><mxGeometry x="1886" y="194" width="320" height="86" as="geometry"/></mxCell>
