        <mxCell id="sim" value="&lt;b&gt;SÍMBOLOS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PK = clave primaria (fondo de color) · FK = clave foránea (cursiva)&lt;br&gt;Pata de gallo = lado «muchos»; barra = obligatorio (1); círculo = opcional (0..1)&lt;br&gt;Toda FK usa ON DELETE CASCADE, salvo evento.materia_id y cambio.materia_id (SET NULL).&lt;br&gt;Los nombres de tabla van en mayúsculas; las columnas conservan los nombres del esquema SQL (db/schema.sql).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#1B2145;" vertex="1" parent="1"><mxGeometry x="1854" y="774" width="352" height="150" as="geometry"/></mxCell>
