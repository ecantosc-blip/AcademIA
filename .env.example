# Copia este archivo como ".env" y llena los datos.
# NUNCA subas el archivo ".env" a GitHub ni lo compartas - puede contener credenciales.

# =====================================================================
# GRUPO 1 — Necesario SIEMPRE para correr la app web (web/app.py)
# Esto NO son datos de una persona en particular - son la configuracion
# general del sistema. Cada usuario que entre a la web pegara SUS PROPIOS
# tokens de sesion (Moodle y ERP) en la pantalla de login del navegador,
# no aqui. La app web NUNCA pide ni guarda contraseñas.
# =====================================================================

# API de Anthropic (para la capa de IA real - core/assistant.py)
# Consiguela en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-tu-api-key-aqui

# Base de datos local compartida (SQLite). No requiere instalar servidor.
DB_PATH=./unemi_assistant.db

# URLs base de las plataformas de UNEMI (normalmente no hay que tocarlas)
SGA_BASE_URL=https://sga.unemi.edu.ec
MOODLE_BASE_URL=https://aulagradoa.unemi.edu.ec
MOODLE_SERVICE=moodle_mobile_app

# --- Opcionales (la app funciona sin ellos) ---
# Horas que dura una sesion web antes de pedir login otra vez (por defecto 8)
# SESSION_TTL_HORAS=8
# Llave para cifrar los tokens guardados en la sesion. Si la dejas vacia, se
# genera sola en el archivo .session_key (no lo subas a git ni lo compartas).
# Para crear una propia: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SESSION_ENC_KEY=
# Puerto y direccion del servidor (por defecto 127.0.0.1:5000)
# PORT=5000
# HOST=127.0.0.1
# Poner en 1 SOLO si la app se sirve por HTTPS
# COOKIE_SECURE=1


# =====================================================================
# GRUPO 2 — SOLO para tus pruebas rápidas por consola/terminal
# (sga/client.py, moodle/client.py, core/sync_all.py, core/assistant.py
# corridos directamente). La app web (web/app.py) NO usa estos valores -
# cada persona que entra por el navegador pone sus tokens en /login.
# Si solo vas a usar la web, puedes dejar esto en blanco.
# =====================================================================

# Tu token de Moodle (el valor de moodlemobile://token=...). Recomendado:
# no usa contraseña. La web NO lee este valor (cada persona lo pega en /login).
MOODLE_TOKEN=pega_aqui_tu_token_de_moodle

# Heredado, solo para correr sync_all.py por consola SIN MOODLE_TOKEN
# (la web NUNCA usa usuario/contraseña). Puedes dejarlo en blanco:
MOODLE_USERNAME=
MOODLE_PASSWORD=

# Tu token del SGA (el login del SGA tiene proteccion anti-bot, asi que
# NO se automatiza - se obtiene UNA VEZ desde el navegador, ver README)
SGA_ACCESS_TOKEN=pega_aqui_el_valor_de_access_desde_devtools
SGA_REFRESH_TOKEN=pega_aqui_el_valor_de_refresh_desde_devtools

# Tu ID de alumno (solo necesario para "Registro Academico" completo,
# se copia de la URL que se ve en DevTools en esa seccion del SGA)
SGA_ALUMNO_ID=pega_aqui_el_id_de_la_url_de_registro_academico

# --- Proteccion y escalabilidad (todo opcional; estos son los valores por defecto) ---
# Limites de uso, formato "peticiones/segundos". Evitan abusos y gasto excesivo de la API.
# LIMITE_LOGIN=10/600        # por IP: intentos de login
# LIMITE_CHAT=20/60          # por sesion: preguntas al asistente
# LIMITE_ESTUDIO=20/300      # por sesion: practicas, videos y tutor
# LIMITE_SYNC=4/300          # por sesion: actualizar datos
# LIMITE_GENERAL=300/60      # por IP: tope a cualquier inundacion
# Tope GLOBAL de consultas a la IA por dia (protege tu factura de la API)
# LIMITE_DIARIO_IA=1000
# Operaciones lentas simultaneas (y sala de espera) antes de responder "ocupado"
# CUPO_SYNC=8
# CUPO_SYNC_COLA=8
# CUPO_IA=16
# CUPO_IA_COLA=8
# Hilos del servidor. Regla: THREADS >= CUPO_SYNC + CUPO_SYNC_COLA + CUPO_IA + CUPO_IA_COLA + 8
# THREADS=48
# Poner en 1 SOLO si la app esta detras de un proxy de confianza (Render, Railway, Cloudflare...)
# para que los limites usen la IP real del usuario
# TRUST_PROXY=1
# Maximo de sesiones de asistente guardadas en memoria
# MAX_SESIONES_MEMORIA=2000
